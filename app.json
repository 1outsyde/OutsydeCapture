{
  "expo": {
    "name": "Outsyde",
    "slug": "outsyde",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/outsyde-icon.jpg",
    "scheme": "outsyde",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.outsyde.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Outsyde uses your camera to create posts and stories.",
        "NSMicrophoneUsageDescription": "Outsyde uses your microphone to record videos.",
        "NSLocationWhenInUseUsageDescription": "Outsyde uses your location to show nearby vendors, photographers, and local businesses in your area. For example, your location helps display relevant listings and services within your community.",
        "NSPhotoLibraryUsageDescription": "Outsyde uses your photo library to let you upload profile photos, post images, and share content with the community. For example, you can select photos from your library when creating a post or setting up your profile."
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.outsyde.app",
      "permissions": ["android.permission.CAMERA", "android.permission.ACCESS_FINE_LOCATION", "android.permission.ACCESS_COARSE_LOCATION"]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/outsyde-icon.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      ["expo-camera", { "enableMicrophonePermission": true }],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.outsyde.app",
          "enableGooglePay": false
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
